<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Project5"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".PastQuizzesActivity"
            android:exported="false" />
        <!-- ONLY HomeActivity has LAUNCHER -->
        <activity
            android:name=".FirstPageActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- NO intent-filter here -->
        <activity android:name=".SignUpActivity" />
        <activity android:name=".ProfileActivity" />
        <activity android:name=".HomeActivity" />
        <activity android:name=".MainActivity" />
        <activity android:name=".QuizActivity" />
        <activity android:name=".LoginPage" />
        <activity android:name=".QuizSetUpActivity" />
        <activity android:name=".PerformanceActivity" />
        <activity android:name=".QuizReviewActivity" />
    </application>

</manifest>