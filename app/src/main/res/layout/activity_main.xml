<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F5F6FA"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
android:id="@+id/main"
        android:padding="20dp"
        tools:ignore="InvalidId">
//
        <!-- Title -->
        <TextView
            android:text="QuizzIt"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="50dp"
            android:textColor="#333333"
            android:layout_marginBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- PDF Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:background="@drawable/rounded_card"
            android:elevation="4dp"
            android:orientation="vertical">

            <TextView
                android:text="Upload PDF(Atmost 5 pages)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnPickPdf"
                android:layout_marginRight="40dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose PDF"
                android:layout_marginLeft="40dp"
                android:backgroundTint="#039BE5"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- URL Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:background="@drawable/rounded_card"
            android:elevation="4dp"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:text="Extract From URL"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_marginBottom="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/etUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Paste URL here..."
                android:padding="14dp"

                android:background="@drawable/input_field"
                android:textColor="#000"
                android:textColorHint="#999"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnFetchUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fetch URL Content"
                android:layout_marginLeft="30dp"
                android:layout_marginRight="30dp"
                android:backgroundTint="#039BE5"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Output Card -->
        <Button
            android:id="@+id/btnGenerateAI"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate AI Quiz"
            android:backgroundTint="#039BE5"
            android:textColor="#FFFFFF"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            app:layout_constraintBottom_toBottomOf="@id/tvOutput"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounded_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="20dp">

            <Button
                android:id="@+id/btnExtractedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show Extracted Text"
                android:textColor="#FFFFFF"
                android:backgroundTint="#039BE5"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Extracted Text"

                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Fixed height text area (scrolls by parent ScrollView) -->


            <TextView
                android:id="@+id/tvOutput"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="@drawable/input_field"
                android:hint="Extracted content will appear here"
                android:padding="12dp"
                android:textColor="#555555" />

            <!--  <Button
                  android:id="@+id/backbutton"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="Back" />-->


        </LinearLayout>

    </LinearLayout>

</ScrollView>
