<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F6FA"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="390dp"
        android:layout_height="100dp"
       android:background="@drawable/bluerectangle"
        android:layout_marginTop="80dp"
        android:orientation="horizontal">


        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/profile" />

        <TextView
android:layout_width="match_parent"
        android:layout_height="wrap_content"

            android:paddingStart="10dp"
            android:paddingTop="40dp"
            android:text="HELLO,Username!"
            android:textColor="@color/white"
            android:textSize="30dp"
            android:textStyle="bold"
            app:srcCompat="@drawable/profile" />



    </LinearLayout>
    <TextView
        android:id="@+id/textView7"
        android:layout_width="365dp"
        android:layout_height="35dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="15dp"
        android:background="@drawable/border"
        android:paddingStart="170dp"
        android:paddingTop="5dp"
        android:text="QUIZIT"
        android:textColor="@color/white"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="25dp"
        tools:layout_editor_absoluteY="141dp" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:paddingStart="20dp"
        android:textSize="20dp"
        android:text="DASHBOARD" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAttemptedQuizzes"
            android:layout_width="175dp"
            android:layout_height="match_parent"
            app:backgroundTint="#00ACC1"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/bluerectangle"
android:textSize="20dp"
            android:text="Past Quizzes"
            android:textStyle="bold"
            tools:layout_editor_absoluteX="25dp"
            tools:layout_editor_absoluteY="374dp" />

        <Button
            android:id="@+id/btnCreateQuiz"
            android:layout_width="171dp"
            android:layout_height="182dp"
            app:backgroundTint="#00ACC1"
            android:background="@drawable/bluerectangle"
            android:textSize="20dp"
            android:text=" NewQuiz"
            android:textStyle="bold"

            tools:layout_editor_absoluteX="215dp"
            tools:layout_editor_absoluteY="376dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <Button
            android:id="@+id/button7"
            android:layout_width="174dp"
            android:layout_height="195dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="0dp"
            android:layout_marginBottom="20sp"
            android:background="@drawable/bluerectangle"
            android:text="Compete"
            android:textSize="20dp"
            android:textStyle="bold"
            app:backgroundTint="#00ACC1"
            tools:layout_editor_absoluteX="219dp"
            tools:layout_editor_absoluteY="519dp" />

        <Button
            android:id="@+id/btnPerformances"
            android:layout_width="174dp"
            android:layout_height="195dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="0dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bluerectangle"
            android:text="My Performances"
            android:textSize="19dp"
            android:textStyle="bold"
            app:backgroundTint="#00ACC1"
            tools:layout_editor_absoluteX="30dp"
            tools:layout_editor_absoluteY="522dp" />

    </LinearLayout>

    <include
    android:id="@+id/pastQuizLayout"
    layout="@layout/pastquizzzes"/>




</LinearLayout>